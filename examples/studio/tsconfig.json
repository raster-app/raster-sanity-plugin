{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["node"],
		"paths": {
			"@raster-app/sanity-plugin-raster": ["../../src/index.tsx"]
		}
	},
	"include": ["*.ts", "../../src"]
}
