# Copy to .env. `sanity dev` reads it when it starts, and the values reach the browser, so none
# of them is a secret: an API key is typed into the picker or the Raster tool.

# Required. A Sanity project you can sign in to, and one of its datasets.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Optional. Pins the plugin to one Raster organization, the id in its Raster URL.
SANITY_STUDIO_RASTER_ORG_ID=
