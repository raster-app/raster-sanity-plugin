{
  "name": "@raster-app/sanity-plugin-raster",
  "private": false,
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://raster.app",
  "author": "Raster <hello@raster.app>",
  "repository": "https://github.com/raster-app/raster-sanity-plugin",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sanity.json"
  ],
  "license": "MIT",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "plugin",
    "raster",
    "dam",
    "digital-asset-management",
    "asset-source"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "lint": "biome lint .",
    "preview": "vite preview",
    "link-watch": "plugin-kit link-watch",
    "prepublishOnly": "pnpm build",
    "pack": "npm pack",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@raster/react": "link:../raster-plugin-sdk/packages/react",
    "@raster/sdk": "link:../raster-plugin-sdk/packages/sdk",
    "@sanity/icons": "^3.7.4 || ^5.2.2"
  },
  "peerDependencies": {
    "@sanity/ui": "^3.0.0 || ^4.0.0",
    "react": "^19",
    "react-dom": "^19",
    "sanity": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@sanity/plugin-kit": "^3.1.10",
    "@sanity/ui": "^4.2.3",
    "@types/node": "^20.11.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.0",
    "sanity": "^6.16.0",
    "styled-components": "^6.1.18",
    "typescript": "5.7.x",
    "vite": "^5.1.0",
    "vite-plugin-dts": "^4.5.3"
  }
}
